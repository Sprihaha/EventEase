# Database Connection Credentials
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=your_db_port
DB_NAME=your_db_name
DB_SSLMODE=require

# CORS Configuration
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*figma\.(site|com)
PORT=8000

# Auth: supply a persistent random JWT secret for deployment.
JWT_SECRET=
ADMIN_PASSWORD=

# EaseXchange policy (requests also expire at the event start).
EXCHANGE_REQUEST_TTL_HOURS=168
EXCHANGE_MATCH_TTL_MINUTES=30
# Reset Demo Data is disabled by default. Production/nonlocal targets require BOTH flags.
# No runtime .env configuration is changed by the implementation task.
DEMO_RESET_ENABLED=false
ALLOW_PRODUCTION_DEMO_RESET=false
