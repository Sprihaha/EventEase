{
  "name": "eventease-backend",
  "private": true,
  "description": "Script aliases for the Python backend. Activate the virtualenv first.",
  "scripts": {
    "dev": "uvicorn app.main:app --reload",
    "migrate": "alembic upgrade head",
    "seed:admin": "python -m app.cli seed-admin",
    "admin:reset-password": "python -m app.cli admin-reset-password",
    "test": "python -m pytest"
  }
}
