# ==============================================================================
# EventEase Backend Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env              (Linux/macOS)
#   Copy-Item .env.example .env       (PowerShell)
# Never commit .env or real secrets.
# ==============================================================================

APP_ENV=development              # development | test | production
LOG_LEVEL=INFO
PORT=8000

# --- PostgreSQL --------------------------------------------------------------
# Either DATABASE_URL=postgresql://user:pass@host:5432/db  or the DB_* values.
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=your_db_name
DB_SSLMODE=require               # use "disable" for the local docker-compose Postgres
DB_SCHEMA=eventease              # dedicated schema; legacy tables stay untouched in public
DB_POOL_SIZE=5                   # keep pool + overflow under your pooler client limit
DB_MAX_OVERFLOW=5
# Tests: optional dedicated database and isolated schema
# TEST_DATABASE_URL=
# TEST_DB_SCHEMA=eventease_test

# --- Auth --------------------------------------------------------------------
JWT_SECRET=                      # REQUIRED in production, >= 32 random chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_SECURE=                 # default: true in production
# COOKIE_SAMESITE=               # default: none in production, lax otherwise
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true

# --- Default administrator ----------------------------------------------------
ADMIN_USERNAME=eventeaseadmin
ADMIN_PASSWORD=                  # optional; leave blank to auto-generate on first seed
AUTO_SEED_ADMIN=true             # seed on startup if no admin exists

# --- CORS / frontend ---------------------------------------------------------
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*figma\.(site|com)
FRONTEND_URL=http://localhost:5173

# --- Events ------------------------------------------------------------------
TICKETMASTER_API_KEY=            # optional; enables the Ticketmaster Discovery adapter
INGEST_AUTO_APPROVE=true
# INCLUDE_SAMPLE_EVENTS=         # default: true outside production, always false in production

# --- Bookings & payments -----------------------------------------------------
PURCHASE_LIMIT_PER_EVENT=6
BOOKING_HOLD_MINUTES=10
CANCELLATION_CUTOFF_HOURS=48
PAYMENT_PROVIDER=mock            # mock | stripe
STRIPE_SECRET_KEY=               # sk_test_... when PAYMENT_PROVIDER=stripe
STRIPE_WEBHOOK_SECRET=

# --- Mail --------------------------------------------------------------------
MAIL_TRANSPORT=console           # console | resend | sendgrid | smtp
MAIL_FROM=EventEase <no-reply@eventease.io>

# Live Mail Provider: Resend (recommended REST API, https://resend.com)
RESEND_API_KEY=

# Live Mail Provider: SendGrid (REST API, https://sendgrid.com)
SENDGRID_API_KEY=

# Live Mail Provider: Standard SMTP (Gmail, Brevo, AWS SES, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# --- PDPA --------------------------------------------------------------------
DATA_RETENTION_DAYS=90
